# Copy this to .env and fill in your values

# Set to 'false' to use the real Python backend, leave unset or 'true' to use mock data
VITE_USE_MOCK=true

# Python backend URL (used if you need to override the Vite proxy target)
# Default target is http://localhost:8000 — see vite.config.js
# VITE_API_BASE_URL=http://localhost:8000
